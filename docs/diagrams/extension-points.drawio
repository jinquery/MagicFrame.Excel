        </mxCell>
        <mxCell id="p1-def" value="默认：AttributeColumnProvider（特性）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
