<mxfile host="app.diagrams.net" agent="MagicFrame.Excel" version="23.1.5">
  <diagram id="extension-points" name="扩展点与开闭原则">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="对修改关闭、对扩展开放 —— 扩展点总览" style="text;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Builder -->
        <mxCell id="builder" value="ExcelEngineBuilder&lt;br&gt;（唯一扩展入口 · 核心引擎零改动）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="280" height="60" as="geometry" />
        </mxCell>

