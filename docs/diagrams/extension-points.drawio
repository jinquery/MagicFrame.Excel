        <mxCell id="p2-cus" value="扩展：字典行 / 索引器 / DataRow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
