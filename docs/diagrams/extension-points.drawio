        <!-- 底部示例代码 -->
        <mxCell id="code" value="注册示例：
ExcelEngineBuilder.Create()
  .UseColumnProvider(configProvider)      // 替换列提供器
  .UseEntityAccessor(dictAccessor)        // 替换访问器（字典行）
  .UseCellValueConverter(currencyConv)    // 替换值转换器（货币）
  .UseFormulaResolver(doubleBracket)      // 替换公式解析器
  .RegisterSheetWriter(&quot;FixedTitle&quot;, w) // 追加表头写入策略
  .RegisterSheetReader(&quot;FixedTitle&quot;, r)  // 追加表头读取策略
  .Build();" style="text;html=1;whiteSpace=pre;align=left;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1160" height="230" as="geometry" />
        </mxCell>
