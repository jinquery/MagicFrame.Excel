<mxfile host="app.diagrams.net" agent="MagicFrame.Excel" version="23.1.5">
  <diagram id="performance" name="性能与保护机制">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="关键性能与保护机制" style="text;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- 1 编译式访问器 -->
        <mxCell id="c1" value="① 编译式访问器 + 读写热路径（ReflectionEntityAccessor）&#10;· 读写编译为表达式树委托，按 (Type, Field) 缓存&#10;· A4 行对象工厂缓存（免每行 Activator）&#10;· A5 读取：纯赋值委托（默认转换器）去二次转换&#10;· A6 导出：getter 按列预解析&#10;· A1 公式预检 / A2 列字母 / A7 值文本列宽&#10;· 无动态程序集 → GC 可回收，无泄漏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="330" height="150" as="geometry" />
        </mxCell>

        <!-- 2 求值器复用 -->
        <mxCell id="c2" value="② 公式求值器复用（DefaultCellValueConverter）&#10;· 按工作簿缓存 1 个 IFormulaEvaluator&#10;· ConditionalWeakTable：不阻止 GC&#10;· 导入公式从 O(n²) 降为线性&#10;&#10;（5000 行公式导入：&gt;300s → ~1.5s）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="70" width="330" height="150" as="geometry" />
        </mxCell>

        <!-- 3 公式导出策略 -->
        <mxCell id="c3" value="③ 公式导出策略（ExcelExportOptions）&#10;· CalculateFormulasOnExport = true（默认）&#10;   EvaluateAllFormulaCells 预计算&#10;· = false：写 calcPr.fullCalcOnLoad&#10;   Excel 打开时重算，导出提速&#10;· 注意：NPOI SetForceFormulaRecalculation&#10;   不可靠，库内直接写 CT_CalcPr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="70" width="320" height="150" as="geometry" />
        </mxCell>

        <!-- 4 锁定与保护 -->
        <mxCell id="c4" value="④ 整列锁定 + 工作表保护（SheetProtector）&#10;· 锁定列：默认列样式 + 单元格样式 IsLocked&#10;· 保护：放开 增行/删行/格式&#10;· 关键：显式放开 排序(sort=0) 和&#10;  自动筛选(autoFilter=0)，否则 Excel&#10;  中排序/筛选被禁用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="330" height="160" as="geometry" />
        </mxCell>

        <!-- 5 导入校验 -->
        <mxCell id="c5" value="⑤ 导入列对应校验（ColumnValidator）&#10;· 缺失列 / 多余列 / 只读列忽略 / 表头重复&#10;· 结果写 Errors，按选项决定是否抛异常&#10;· 只读= get-only（private set 可写）&#10;· 不存在的 Field 视为可写（兼容自定义访问器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="260" width="330" height="160" as="geometry" />
        </mxCell>

        <!-- 6 压测工具 -->
        <mxCell id="c6" value="⑥ 压力测试（tools/ 独立项目）&#10;· StressRow：30 列（字符串/数值/金额/日期/布尔）&#10;· 5000×30：导出 ≈1.2s，导入 ≈1.1s&#10;· 公式模式 -- formula 5000 30：&#10;   预计算 vs 打开时重算 对比&#10;· 预热一次后计时，校验行数与抽样值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="260" width="320" height="160" as="geometry" />
        </mxCell>

        <!-- 底部性能数据 -->
        <mxCell id="bar" value="实测（本机 net6.0 / Debug）&#10;普通 5000×30：导出 ≈1.2s（≈4000 行/s） · 导入 ≈1.1s（≈4500 行/s）&#10;公式 5000×31：导出 ≈1.4s（预计算）/ ≈1.3s（延后） · 导入 ≈1.6s（线性，修复前 &gt;300s）" style="text;html=1;whiteSpace=wrap;align=center;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1020" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
